# System Environment Variables Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=techstoredb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/techstoredb

# MongoDB Configuration
MONGO_URI=mongodb://your_mongo_user:your_mongo_password@localhost:27017/techstore_audit?authSource=admin

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:5000/api
