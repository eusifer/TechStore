{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Total Solicitudes HTTP",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(techstore_http_requests_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Pedidos Creados",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "techstore_orders_created_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errores en Pedidos",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "techstore_order_errors_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tasa de Solicitudes por Segundo (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(techstore_http_requests_total[1m])",
          "legendFormat": "{{method}} {{route}} ({{status_code}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia Promedio HTTP (segundos)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(techstore_http_request_duration_seconds_sum[1m]) / rate(techstore_http_request_duration_seconds_count[1m])",
          "legendFormat": "Latencia {{method}} {{route}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["techstore", "monitoring"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "TechStore Metrics Dashboard",
  "uid": "techstore-main-dashboard"
}
